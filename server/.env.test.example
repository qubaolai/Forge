# ──────────────────────────────────────────────────────────────────────────────
# .env.test.example — 测试环境专属覆盖模板 (拷贝为 .env.test)
# 启动: APP_ENV=test pytest  或  make test-unit
# sys_config.test.yaml 已内置大量测试默认值，这里只覆盖真正不同的项
# ──────────────────────────────────────────────────────────────────────────────

# ── 减少测试输出噪音 ──────────────────────────────────────────────────────────
APP_LOG_LEVEL=WARNING
APP_PORT=8555

# ── 集成测试时填入真实 key 跑通端到端 ─────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# DASHSCOPE_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
