# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Forge 服务公共基础变量模板
# 拷贝为 .env 后填入真实值
# 加载优先级: Shell > .env.{APP_ENV} > .env > yaml 默认值
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO
APP_PORT=8553
USER_CACHE_TTL=259200
FORGE_ENCRYPTION_KEY=D6wxjuD+B6rqOYRwtDGvVD/Hyi8G8mD45uv/mWo9e9M=
_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/models

# ── JWT / Auth (必填) ─────────────────────────────────────────────────────────
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_64_char_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=60
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ── CORS / Rate Limit ─────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=60

# ── Database (必填) ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=forge
DB_PASSWORD=
DB_DATABASE=forge
DB_ECHO=false

# ── Redis (必填) ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# ──────────────────────────────────────────────────────────────────────────────
# LLM 模型配置
# Forge 模型分工:
#   fast   (探索/简单任务): sonnet-4-6
#   smart  (通用任务):      sonnet-4-6
#   strong (规划/高质量):   opus-4-7
# ──────────────────────────────────────────────────────────────────────────────

# ── Forge AdaptiveRun 模型档位 ────────────────────────────────────────────────
FAST_MODEL=claude-sonnet-4-6
SMART_MODEL=claude-sonnet-4-6
STRONG_MODEL=claude-opus-4-7

# ── 主对话模型 ────────────────────────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-sonnet-4-6
LLM_FALLBACK_CHAIN=
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=1.0

# ── 记忆摘要模型 ──────────────────────────────────────────────────────────────
MEMORY_SUMMARIZER_PROVIDER=anthropic
MEMORY_SUMMARIZER_MODEL=claude-haiku-4-5-20251001
MEMORY_TRIGGER_EVERY_N=10

# ── 工具模型 (标题生成 / 上下文压缩等轻量任务) ────────────────────────────────
UTILITY_LLM_PROVIDER=anthropic
UTILITY_LLM_MODEL=claude-haiku-4-5-20251001

# ── Provider API Keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# ── LLM 预算 ─────────────────────────────────────────────────────────────────
LLM_BUDGET_GLOBAL_USD=
LLM_BUDGET_DEFAULT_USER_USD=
LLM_BUDGET_ALERT=0.8

# ── Embedding / Reranker ─────────────────────────────────────────────────────
EMBEDDING_PROVIDER=dashscope
RERANKER_PROVIDER=dashscope

# ── Observability ─────────────────────────────────────────────────────────────
TRACING_ENABLED=false
TRACING_EXPORTER=none
OTEL_SERVICE_NAME=forge
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
